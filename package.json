{
  "name": "parsecstudio-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "parsec.studio — the Parsec Studio website (director-led video production).",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "live": "node scripts/live.mjs",
    "build": "tsc --noEmit && vite build",
